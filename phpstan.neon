includes:
parameters:
  level: 7
  paths:
      - src
  treatPhpDocTypesAsCertain: false
  ignoreErrors:
    - '#is never written, only read\.$#'
    - '#Property .* is never assigned .* so it can be removed from the property type\.#'
    - '#Offset .sstatus. on array.* in isset\(\) always exists and is not nullable\.#'
